# Copy this file to .env.local and provide your own private values.
# Never commit .env.local or real credentials.

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=maintenance_triage
# Optional comma-separated DNS resolvers, e.g. 1.1.1.1,8.8.8.8
MONGODB_DNS_SERVERS=

# Authentication
# Generate a private random value of at least 32 characters.
AUTH_SECRET=
# Optional legacy fallback; prefer AUTH_SECRET.
NEXTAUTH_SECRET=
# Required only to register technician accounts.
TECHNICIAN_INVITE_CODE=

# Chat model provider; model IDs must be available to your provider account.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Embeddings and Atlas Vector Search (optional for vector retrieval).
# Select a provider that supports embeddings for your account.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=
GROQ_EMBEDDING_MODEL=
ATLAS_VECTOR_INDEX=

# Development/testing only; simulated failures are disabled in production.
DEBUG_FAIL=
